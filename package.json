{
  "name": "theaihatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, replayable AI coding workspace.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @theaihatch/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace @theaihatch/web",
    "package:plan": "vite-node --script packages/packaging/src/cli.ts plan",
    "package:build": "vite-node --script packages/packaging/src/cli.ts build",
    "package:smoke": "vite-node --script packages/packaging/src/smoke.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.6",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
